generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @db.VarChar(36)
  email         String   @unique @db.VarChar(255)
  passwordHash  String?  @map("password_hash") @db.VarChar(255)
  tokenVersion  Int      @default(0) @map("token_version")
  firstName     String?  @map("first_name") @db.VarChar(255)
  lastName      String?  @map("last_name") @db.VarChar(255)
  role          String   @db.VarChar(50)
  emailVerified Boolean  @default(false) @map("email_verified")
  preferredOrganizationId String? @map("preferred_organization_id") @db.VarChar(36)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  devices       Device[]
  oauthIdentities OAuthIdentity[]
  profile       Profile?
  postingReviews PostingReview[] @relation("PostingReviewAuthor")
  bookingRequestsAsRenter BookingRequest[] @relation("BookingRequestRenter")
  rentingsAsRenter Renting[] @relation("RentingRenter")
  rentingDisputesOpened RentingDispute[] @relation("RentingDisputeOpenedBy")
  paymentsAsRenter Payment[] @relation("PaymentRenter")
  refundsIssued    Refund[]  @relation("RefundIssuer")
  personalAccessTokens PersonalAccessToken[]
  recommendationProfile UserRecommendationProfile?
  recommendationSnapshot UserRecommendationSnapshot?
  feedbacks               Feedback[]
  filedContentReports    ContentReport[]      @relation("ContentReportReporter")
  assignedContentReports ContentReport[]      @relation("ContentReportAssignee")
  contentReportEvents    ContentReportEvent[] @relation("ContentReportEventActor")
  preferredOrganization  Organization?        @relation("PreferredOrganization", fields: [preferredOrganizationId], references: [id], onDelete: SetNull)
  organizationMemberships OrganizationMembership[]
  organizationInvitationsSent OrganizationInvitation[] @relation("OrganizationInvitationInviter")
  acceptedOrganizationInvitations OrganizationInvitation[] @relation("OrganizationInvitationAccepter")
  organizationAuditLogs OrganizationAuditLog[] @relation("OrganizationAuditActor")
  mfaTotp                UserMfaTotp?

  @@map("users")
}

model Organization {
  id           String   @id @db.VarChar(36)
  name         String   @db.VarChar(160)
  description  String?  @db.Text
  websiteUrl   String?  @map("website_url") @db.VarChar(500)
  contactEmail String?  @map("contact_email") @db.VarChar(320)
  contactPhone String?  @map("contact_phone") @db.VarChar(40)
  addressLine1 String?  @map("address_line1") @db.VarChar(200)
  addressLine2 String?  @map("address_line2") @db.VarChar(200)
  city         String?  @db.VarChar(120)
  region       String?  @db.VarChar(120)
  country      String?  @db.VarChar(120)
  postalCode   String?  @map("postal_code") @db.VarChar(20)
  logoUrl      String?  @map("logo_url") @db.VarChar(1024)
  logoBlobName String?  @map("logo_blob_name") @db.VarChar(1024)
  customFields Json?    @map("custom_fields")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  preferredByUsers User[] @relation("PreferredOrganization")
  postings    Posting[]
  bookingRequests BookingRequest[]
  rentings    Renting[]
  payments    Payment[]
  payouts     Payout[]
  postingViewEvents PostingViewEvent[]
  postingAnalyticsHourly PostingAnalyticsHourly[]
  postingAnalyticsDaily PostingAnalyticsDaily[]
  postingAnalyticsOutbox PostingAnalyticsOutbox[]
  recommendationActivities RecommendationActivity[]
  auditLogs OrganizationAuditLog[]
  searchOutboxEntries OrganizationSearchOutbox[]

  @@map("organizations")
}
model OrganizationAuditLog {
  id                    String   @id @db.VarChar(36)
  organizationId        String   @map("organization_id") @db.VarChar(36)
  actorUserId           String?  @map("actor_user_id") @db.VarChar(36)
  action                String   @db.VarChar(80)
  resourceType          String   @map("resource_type") @db.VarChar(60)
  resourceId            String?  @map("resource_id") @db.VarChar(64)
  organizationVersion   Int      @map("organization_version")
  resourceVersion       Int?     @map("resource_version")
  summary               String   @db.VarChar(255)
  changes               Json?
  beforeSnapshot        Json?    @map("before_snapshot")
  afterSnapshot         Json?    @map("after_snapshot")
  restorable            Boolean  @default(false)
  restoredFromAuditId   String?  @map("restored_from_audit_id") @db.VarChar(36)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(6)
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor                 User?    @relation("OrganizationAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@unique([organizationId, organizationVersion], map: "organization_audit_logs_org_version_unique")
  @@unique([organizationId, resourceType, resourceId, resourceVersion], map: "org_audit_resource_version_unique")
  @@index([actorUserId, createdAt])
  @@map("organization_audit_logs")
}

model OrganizationMembership {
  id             String           @id @db.VarChar(36)
  organizationId String           @map("organization_id") @db.VarChar(36)
  userId         String           @map("user_id") @db.VarChar(36)
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, role])
  @@index([organizationId, role])
  @@map("organization_memberships")
}

model OrganizationInvitation {
  id               String                   @id @db.VarChar(36)
  organizationId   String                   @map("organization_id") @db.VarChar(36)
  invitedByUserId  String                   @map("invited_by_user_id") @db.VarChar(36)
  acceptedByUserId String?                  @map("accepted_by_user_id") @db.VarChar(36)
  email            String                   @db.VarChar(255)
  role             OrganizationRole
  tokenHash        String                   @unique @map("token_hash") @db.VarChar(128)
  status           OrganizationInviteStatus @default(pending)
  expiresAt        DateTime                 @map("expires_at") @db.DateTime(6)
  acceptedAt       DateTime?                @map("accepted_at") @db.DateTime(6)
  revokedAt        DateTime?                @map("revoked_at") @db.DateTime(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.DateTime(6)
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedByUser    User                     @relation("OrganizationInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedByUser   User?                    @relation("OrganizationInvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, expiresAt])
  @@index([organizationId, email, status])
  @@index([email, status, expiresAt])
  @@index([invitedByUserId, createdAt])
  @@map("organization_invitations")
}

model UserMfaTotp {
  id              String            @id @db.VarChar(36)
  userId          String            @unique @map("user_id") @db.VarChar(36)
  secretEncrypted String            @map("secret_encrypted") @db.Text
  status          UserMfaTotpStatus @default(pending)
  expiresAt       DateTime?         @map("expires_at") @db.DateTime(6)
  lastUsedCounter BigInt?           @map("last_used_counter")
  confirmedAt     DateTime?         @map("confirmed_at") @db.DateTime(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.DateTime(6)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_mfa_totp")
}

model PersonalAccessToken {
  id          String   @id @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  name        String   @db.VarChar(120)
  publicId    String   @unique @map("public_id") @db.VarChar(32)
  tokenPrefix String   @map("token_prefix") @db.VarChar(64)
  secretHash  String   @map("secret_hash") @db.VarChar(255)
  scopes      Json
  lastUsedAt  DateTime? @map("last_used_at") @db.DateTime(6)
  expiresAt   DateTime? @map("expires_at") @db.DateTime(6)
  revokedAt   DateTime? @map("revoked_at") @db.DateTime(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([publicId])
  @@map("personal_access_tokens")
}

model OAuthIdentity {
  id             String   @id @db.VarChar(36)
  userId         String   @map("user_id") @db.VarChar(36)
  provider       String   @db.VarChar(50)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  providerEmail  String?  @map("provider_email") @db.VarChar(255)
  emailVerified  Boolean  @default(false) @map("email_verified")
  displayName    String?  @map("display_name") @db.VarChar(255)
  linkedAt       DateTime @default(now()) @map("linked_at") @db.DateTime(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_identities")
}

model Profile {
  id                       String   @id @db.VarChar(36)
  userId                   String   @unique @map("user_id") @db.VarChar(36)
  username                 String   @unique @db.VarChar(50)
  phoneNumber              String?  @map("phone_number") @db.VarChar(32)
  avatarUrl                String?  @map("avatar_url") @db.VarChar(2048)
  avatarBlobName           String?  @map("avatar_blob_name") @db.VarChar(1024)
  isPrivate                Boolean  @default(false) @map("is_private")
  recommendationPersonalizationEnabled Boolean @default(true) @map("recommendation_personalization_enabled")
  trustworthinessScore     Int      @default(1) @map("trustworthiness_score")
  rentPostingsCount        Int      @default(0) @map("rent_postings_count")
  availableRentPostingsCount Int    @default(0) @map("available_rent_postings_count")
  createdAt                DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profiles")
}

model Device {
  id            String   @id @db.VarChar(36)
  userId        String   @map("user_id") @db.VarChar(36)
  deviceId      String   @map("device_id") @db.VarChar(255)
  type          String   @db.VarChar(50)
  platform      String?  @db.VarChar(255)
  userAgent     String?  @map("user_agent") @db.VarChar(1024)
  lastIpAddress String?  @map("last_ip_address") @db.VarChar(255)
  firstSeenAt   DateTime @default(now()) @map("first_seen_at") @db.DateTime(6)
  lastSeenAt    DateTime @default(now()) @map("last_seen_at") @db.DateTime(6)
  verifiedAt    DateTime @default(now()) @map("verified_at") @db.DateTime(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("devices")
}

model Posting {
  id                String                     @id @db.VarChar(36)
  organizationId    String                     @map("organization_id") @db.VarChar(36)
  status            PostingStatus
  family            PostingFamily
  subtype           String                     @db.VarChar(50)
  name              String                     @db.VarChar(150)
  description       String                     @db.Text
  pricingCurrency   String                     @map("pricing_currency") @db.VarChar(3)
  pricing           Json
  tags              Json
  placeDetails      Json?                      @map("place_details")
  equipmentDetails  Json?                      @map("equipment_details")
  vehicleDetails    Json?                      @map("vehicle_details")
  availabilityStatus PostingAvailabilityStatus @map("availability_status")
  availabilityNotes String?                    @map("availability_notes") @db.VarChar(500)
  maxBookingDurationDays Int?                  @map("max_booking_duration_days")
  minBookingDurationDays Int?                  @map("min_booking_duration_days")
  advanceNoticeDays      Int?                  @map("advance_notice_days")
  cancellationPolicy     PostingCancellationPolicy? @map("cancellation_policy")
  cancellationPolicyNotes String?              @map("cancellation_policy_notes") @db.VarChar(500)
  instantBooking    Boolean                    @default(false) @map("instant_booking")
  averageRating     Decimal?                   @map("average_rating") @db.Decimal(3, 2)
  reviewCount       Int                        @default(0) @map("review_count")
  latitude          Float
  longitude         Float
  city              String                     @db.VarChar(120)
  region            String                     @db.VarChar(120)
  country           String                     @db.VarChar(120)
  postalCode        String?                    @map("postal_code") @db.VarChar(32)
  publishedAt       DateTime?                  @map("published_at") @db.DateTime(6)
  pausedAt          DateTime?                  @map("paused_at") @db.DateTime(6)
  archivedAt        DateTime?                  @map("archived_at") @db.DateTime(6)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.DateTime(6)
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  photos            PostingPhoto[]
  availabilityBlocks PostingAvailabilityBlock[]
  searchOutboxEntries PostingSearchOutbox[]
  viewEvents        PostingViewEvent[]
  recommendationActivities RecommendationActivity[]
  hourlyAnalytics   PostingAnalyticsHourly[]
  dailyAnalytics    PostingAnalyticsDaily[]
  analyticsOutboxEntries PostingAnalyticsOutbox[]
  reviews           PostingReview[]
  seasonalPricing   PostingSeasonalPricing[]
  bookingRequests   BookingRequest[]
  rentings          Renting[]
  payments          Payment[]

  @@index([organizationId, status])
  @@index([status, publishedAt])
  @@index([status, family, subtype, publishedAt])
  @@index([country, region, city])
  @@map("postings")
}

model PostingSeasonalPricing {
  id          String   @id @db.VarChar(36)
  postingId   String   @map("posting_id") @db.VarChar(36)
  name        String   @db.VarChar(100)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  dailyAmount Decimal  @map("daily_amount") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  posting     Posting  @relation(fields: [postingId], references: [id], onDelete: Cascade)

  @@index([postingId])
  @@map("posting_seasonal_pricing")
}

model PostingPhoto {
  id         String   @id @db.VarChar(36)
  postingId  String   @map("posting_id") @db.VarChar(36)
  blobUrl    String   @map("blob_url") @db.VarChar(2048)
  blobName   String   @map("blob_name") @db.VarChar(1024)
  thumbnailBlobUrl  String?  @map("thumbnail_blob_url") @db.VarChar(2048)
  thumbnailBlobName String?  @map("thumbnail_blob_name") @db.VarChar(1024)
  position   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  posting    Posting  @relation(fields: [postingId], references: [id], onDelete: Cascade)

  @@unique([postingId, position])
  @@index([postingId])
  @@map("posting_photos")
}

model PostingAvailabilityBlock {
  id         String   @id @db.VarChar(36)
  postingId  String   @map("posting_id") @db.VarChar(36)
  startAt    DateTime @map("start_at") @db.DateTime(6)
  endAt      DateTime @map("end_at") @db.DateTime(6)
  note       String?  @db.VarChar(255)
  source     PostingAvailabilityBlockSource @default(owner)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  posting    Posting  @relation(fields: [postingId], references: [id], onDelete: Cascade)
  bookingRequestHold BookingRequest? @relation("BookingRequestHold")

  @@index([postingId, source, startAt, endAt])
  @@index([postingId, startAt, endAt])
  @@map("posting_availability_blocks")
}

model BookingRequest {
  id             String               @id @db.VarChar(36)
  postingId       String               @map("posting_id") @db.VarChar(36)
  renterId        String               @map("renter_id") @db.VarChar(36)
  organizationId  String               @map("organization_id") @db.VarChar(36)
  status          BookingRequestStatus
  startAt         DateTime             @map("start_at") @db.DateTime(6)
  endAt           DateTime             @map("end_at") @db.DateTime(6)
  durationDays    Int                  @map("duration_days")
  guestCount      Int                  @map("guest_count")
  contactName     String               @map("contact_name") @db.VarChar(255)
  contactEmail    String               @map("contact_email") @db.VarChar(255)
  contactPhoneNumber String?           @map("contact_phone_number") @db.VarChar(32)
  note            String?              @db.VarChar(1000)
  pricingCurrency String               @map("pricing_currency") @db.VarChar(3)
  pricingSnapshot Json                 @map("pricing_snapshot")
  dailyPriceAmount Decimal             @map("daily_price_amount") @db.Decimal(18, 2)
  estimatedTotal  Decimal              @map("estimated_total") @db.Decimal(18, 2)
  decisionNote    String?              @map("decision_note") @db.VarChar(1000)
  approvedAt      DateTime?            @map("approved_at") @db.DateTime(6)
  paymentRequiredAt DateTime?          @map("payment_required_at") @db.DateTime(6)
  paymentFailedAt DateTime?            @map("payment_failed_at") @db.DateTime(6)
  cancelledAt     DateTime?            @map("cancelled_at") @db.DateTime(6)
  cancelledByUserId String?            @map("cancelled_by_user_id") @db.VarChar(36)
  cancellationActor BookingCancellationActor? @map("cancellation_actor")
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(1000)
  cancellationPolicyCode String?       @map("cancellation_policy_code") @db.VarChar(100)
  cancellationRefundAmount Decimal?    @map("cancellation_refund_amount") @db.Decimal(18, 2)
  refundedAt      DateTime?            @map("refunded_at") @db.DateTime(6)
  declinedAt      DateTime?            @map("declined_at") @db.DateTime(6)
  expiredAt       DateTime?            @map("expired_at") @db.DateTime(6)
  convertedAt     DateTime?            @map("converted_at") @db.DateTime(6)
  conversionReservedAt DateTime?       @map("conversion_reserved_at") @db.DateTime(6)
  conversionReservationExpiresAt DateTime? @map("conversion_reservation_expires_at") @db.DateTime(6)
  holdExpiresAt   DateTime             @map("hold_expires_at") @db.DateTime(6)
  holdBlockId     String?              @unique @map("hold_block_id") @db.VarChar(36)
  paymentReconciliationRequired Boolean @default(false) @map("payment_reconciliation_required")
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.DateTime(6)
  posting         Posting              @relation(fields: [postingId], references: [id], onDelete: Cascade)
  renter          User                 @relation("BookingRequestRenter", fields: [renterId], references: [id], onDelete: Cascade)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  holdBlock       PostingAvailabilityBlock? @relation("BookingRequestHold", fields: [holdBlockId], references: [id], onDelete: SetNull)
  renting         Renting?
  payment         Payment?

  @@index([postingId, status, startAt])
  @@index([postingId, holdExpiresAt])
  @@index([status, conversionReservationExpiresAt])
  @@index([organizationId, status, createdAt])
  @@index([renterId, status, createdAt])
  @@index([status, holdExpiresAt])
  @@map("booking_requests")
}

model Renting {
  id               String        @id @db.VarChar(36)
  postingId         String        @map("posting_id") @db.VarChar(36)
  bookingRequestId  String        @unique @map("booking_request_id") @db.VarChar(36)
  renterId          String        @map("renter_id") @db.VarChar(36)
  organizationId    String        @map("organization_id") @db.VarChar(36)
  status            RentingStatus
  startAt           DateTime      @map("start_at") @db.DateTime(6)
  endAt             DateTime      @map("end_at") @db.DateTime(6)
  durationDays      Int           @map("duration_days")
  guestCount        Int           @map("guest_count")
  pricingCurrency   String        @map("pricing_currency") @db.VarChar(3)
  pricingSnapshot   Json          @map("pricing_snapshot")
  dailyPriceAmount  Decimal       @map("daily_price_amount") @db.Decimal(18, 2)
  estimatedTotal    Decimal       @map("estimated_total") @db.Decimal(18, 2)
  confirmedAt       DateTime      @map("confirmed_at") @db.DateTime(6)
  pickupInstructions String?      @map("pickup_instructions") @db.VarChar(1000)
  returnInstructions String?      @map("return_instructions") @db.VarChar(1000)
  checkInReadyAt    DateTime?     @map("check_in_ready_at") @db.DateTime(6)
  checkInCompletedAt DateTime?    @map("check_in_completed_at") @db.DateTime(6)
  returnDueAt       DateTime?     @map("return_due_at") @db.DateTime(6)
  completedAt       DateTime?     @map("completed_at") @db.DateTime(6)
  disputedAt        DateTime?     @map("disputed_at") @db.DateTime(6)
  cancelledAt       DateTime?     @map("cancelled_at") @db.DateTime(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.DateTime(6)
  posting           Posting       @relation(fields: [postingId], references: [id], onDelete: Cascade)
  bookingRequest    BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  renter            User          @relation("RentingRenter", fields: [renterId], references: [id], onDelete: Cascade)
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dispute           RentingDispute?

  @@index([postingId, status, startAt])
  @@index([renterId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("rentings")
}

model RentingDispute {
  id             String   @id @db.VarChar(36)
  rentingId      String   @unique @map("renting_id") @db.VarChar(36)
  openedByUserId String   @map("opened_by_user_id") @db.VarChar(36)
  reason         String   @db.VarChar(255)
  details        String?  @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  renting        Renting  @relation(fields: [rentingId], references: [id], onDelete: Cascade)
  openedBy       User     @relation("RentingDisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: Cascade)

  @@index([openedByUserId, createdAt])
  @@map("renting_disputes")
}

model Payment {
  id                   String         @id @db.VarChar(36)
  bookingRequestId     String         @unique @map("booking_request_id") @db.VarChar(36)
  postingId            String         @map("posting_id") @db.VarChar(36)
  renterId             String         @map("renter_id") @db.VarChar(36)
  organizationId       String         @map("organization_id") @db.VarChar(36)
  provider             PaymentProvider
  status               PaymentStatus
  pricingCurrency      String         @map("pricing_currency") @db.VarChar(3)
  rentalSubtotalAmount Decimal        @map("rental_subtotal_amount") @db.Decimal(18, 2)
  platformFeeAmount    Decimal        @map("platform_fee_amount") @db.Decimal(18, 2)
  totalAmount          Decimal        @map("total_amount") @db.Decimal(18, 2)
  squarePaymentId      String?        @unique @map("square_payment_id") @db.VarChar(128)
