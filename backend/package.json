{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "seed": "tsx src/app/scripts/seed.ts",
    "seed:dev": "tsx src/app/scripts/seed.ts",
    "seed:refresh": "tsx src/app/scripts/seed.ts --refresh",
    "openapi:generate": "tsx src/app/scripts/openapi.ts --write",
    "openapi:check": "tsx src/app/scripts/openapi.ts --check",
    "dev:analytics-worker": "tsx watch src/app/workers/analytics/postings-analytics.worker.ts",
    "dev:booking-expiry-worker": "tsx watch src/app/workers/bookings/booking-expiry.worker.ts",
    "dev:email-worker": "tsx watch src/app/workers/email/email-delivery.worker.ts",
    "dev:sms-worker": "tsx watch src/app/workers/sms/sms-delivery.worker.ts",
    "dev:log-consumer-worker": "tsx watch src/app/workers/logging/log-consumer.worker.ts",
    "dev:payment-repair-worker": "tsx watch src/app/workers/payments/payment-repair.worker.ts",
    "dev:payment-retry-worker": "tsx watch src/app/workers/payments/payment-retry.worker.ts",
    "dev:payout-release-worker": "tsx watch src/app/workers/payments/payout-release.worker.ts",
    "dev:posting-thumbnail-worker": "tsx watch src/app/workers/postings/posting-thumbnail.worker.ts",
    "dev:recommendation-activity-worker": "tsx watch src/app/workers/recommendations/recommendation-activity.worker.ts",
    "dev:recommendation-precompute-worker": "tsx watch src/app/workers/recommendations/recommendation-precompute.worker.ts",
    "dev:report-search-indexer-worker": "tsx watch src/app/workers/reports/report-search-indexer.worker.ts",
    "dev:search-worker": "tsx watch src/app/workers/search/search-maintainer.worker.ts",
    "dev:search-maintainer-worker": "tsx watch src/app/workers/search/search-maintainer.worker.ts",
    "dev:search-indexer-worker": "tsx watch src/app/workers/search/search-indexer.worker.ts",
    "dev:organization-search-maintainer-worker": "tsx watch src/app/workers/organizations/organization-search-maintainer.worker.ts",
    "dev:organization-search-indexer-worker": "tsx watch src/app/workers/organizations/organization-search-indexer.worker.ts",
    "dev:organization-blog-search-maintainer-worker": "tsx watch src/app/workers/organizations/organization-blog-search-maintainer.worker.ts",
    "dev:organization-blog-search-indexer-worker": "tsx watch src/app/workers/organizations/organization-blog-search-indexer.worker.ts",
    "build": "tsup src/app/server.ts src/app/scripts/seed.ts src/app/workers/analytics/postings-analytics.worker.ts src/app/workers/bookings/booking-expiry.worker.ts src/app/workers/email/email-delivery.worker.ts src/app/workers/sms/sms-delivery.worker.ts src/app/workers/logging/log-consumer.worker.ts src/app/workers/payments/payment-retry.worker.ts src/app/workers/payments/payment-repair.worker.ts src/app/workers/payments/payout-release.worker.ts src/app/workers/postings/posting-thumbnail.worker.ts src/app/workers/recommendations/recommendation-activity.worker.ts src/app/workers/recommendations/recommendation-precompute.worker.ts src/app/workers/reports/report-search-indexer.worker.ts src/app/workers/search/search-maintainer.worker.ts src/app/workers/search/search-indexer.worker.ts src/app/workers/organizations/organization-search-maintainer.worker.ts src/app/workers/organizations/organization-search-indexer.worker.ts src/app/workers/organizations/organization-blog-search-maintainer.worker.ts src/app/workers/organizations/organization-blog-search-indexer.worker.ts --tsconfig tsconfig.app.json --format esm --platform node --target node24 --out-dir dist --clean",
    "format": "npx --yes prettier@3.6.2 --write .",
    "format:diff": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/format-diff.ps1 backend",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "start": "node dist/server.js",
    "check": "tsc --noEmit --project tsconfig.app.json",
    "check:test": "tsc --noEmit --project tsconfig.test.json",
    "check:all": "npm run check && npm run check:test",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:unit": "jest --config jest.unit.config.cjs --runInBand",
    "test:unit:coverage": "jest --config jest.unit.config.cjs --runInBand --coverage",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:integration:mocked": "jest --config jest.mocked.integration.config.cjs --runInBand",
    "test:integration:routes": "jest --config jest.mocked.integration.config.cjs --runInBand",
    "test:db-seeds": "jest --config jest.db-seeds.config.cjs --runInBand"
  },
  "prisma": {
    "seed": "tsx src/app/scripts/seed.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@hono/node-server": "^1.19.4",
    "@prisma/client": "^6.7.0",
    "amqplib": "^1.0.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "hono": "^4.9.8",
    "mysql2": "^3.15.2",
    "nodemailer": "^8.0.5",
    "redis": "^5.8.2",
    "sharp": "^0.34.5",
    "xss": "^1.0.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "jest": "^30.3.0",
    "prisma": "^6.7.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.27.7": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  }
}
