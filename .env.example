# Backend bootstrap. Leave BACKEND_CONFIG_FILE empty to use the committed
# default.yml + development.yml profiles.
NODE_ENV=development
BACKEND_CONFIG_FILE=

# Backend secrets and secret-bearing connection strings.
DATABASE_URL=mysql://rent:rent@mysql:3306/rent
REDIS_URL=
REDIS_PASSWORD=
RABBITMQ_URL=amqp://rabbitmq:5672
ELASTICSEARCH_PASSWORD=
# Blob storage authenticates with Microsoft Entra ID: one service principal
# per service that touches blobs, all in AZURE_TENANT_ID. Leave the account URL
# empty to keep blobs on local disk instead. See "Microsoft Entra ID
# authentication" in docs/backend-configuration.md.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_TENANT_ID=
API_AZURE_CLIENT_ID=
API_AZURE_CLIENT_SECRET=
MEDIA_PROCESSING_AZURE_CLIENT_ID=
MEDIA_PROCESSING_AZURE_CLIENT_SECRET=
MEDIA_CLEANUP_AZURE_CLIENT_ID=
MEDIA_CLEANUP_AZURE_CLIENT_SECRET=
POSTING_THUMBNAIL_AZURE_CLIENT_ID=
POSTING_THUMBNAIL_AZURE_CLIENT_SECRET=
BLOB_CLEANUP_AZURE_CLIENT_ID=
BLOB_CLEANUP_AZURE_CLIENT_SECRET=
MEDIA_BACKFILL_AZURE_CLIENT_ID=
MEDIA_BACKFILL_AZURE_CLIENT_SECRET=
MEDIA_REPLAY_AZURE_CLIENT_ID=
MEDIA_REPLAY_AZURE_CLIENT_SECRET=
# Docker Desktop: set this so those services can reach the Microsoft sign-in
# endpoint (see docker-compose.yml). Leave it unset on networks that block
# public DNS.
# BLOB_SERVICES_DNS=1.1.1.1
# Deprecated: sign with the account key instead. Set both lines to opt in.
# AZURE_STORAGE_AUTH=connection-string
# AZURE_STORAGE_CONNECTION_STRING=
# Access tokens default to HS256. For RS256, set ACCESS_TOKEN_ALGORITHM=RS256,
# clear ACCESS_TOKEN_SECRET, and provide PEM keys with \n-escaped newlines.
ACCESS_TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_SECRET=change-me-access-token-secret-at-least-32
ACCESS_TOKEN_PRIVATE_KEY=
ACCESS_TOKEN_PUBLIC_KEY=
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
PERSONAL_ACCESS_TOKEN_SECRET=change-me-personal-access-token-secret
MFA_TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GMAIL_APP_PASSWORD=change-me
CLOUDFLARE_TURNSTILE_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Apple Sign in: Services ID, team ID, key ID, and the .p8 key (PEM; \n-escaped
# newlines are accepted). Only the private key is a secret.
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
# PayPal REST app (developer.paypal.com). The client ID and webhook ID are not
# secret: they default to placeholders in backend/config and can be set here.
PAYPAL_CLIENT_SECRET=change-me-paypal-client-secret
# PAYPAL_CLIENT_ID=
# PAYPAL_WEBHOOK_ID=
# Embedded checkout methods (comma-separated): paypal, paypal_guest, card.
# Defaults to all three.
# PAYPAL_CHECKOUT_METHODS=
TELNYX_API_KEY=

# Frontend build/runtime configuration remains environment-based.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8040/api/v1
INTERNAL_API_BASE_URL=http://backend:8040/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_OAUTH_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_OAUTH_TENANT=consumers
NEXT_PUBLIC_APPLE_OAUTH_CLIENT_ID=
# Same value as PAYPAL_CLIENT_ID. Empty keeps checkout on the PayPal redirect.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Optional Docker host-port overrides.
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
ELASTICSEARCH_HOST_PORT=9201
RABBITMQ_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673

# Optional MCP credential.
RENTIFY_PAT=
