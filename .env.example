NODE_ENV=development
DATABASE_URL=mysql://rent:rent@mysql:3306/rent
REDIS_HOST=redis
REDIS_PORT=6379
DISABLED_ROUTE_MODULES=
# Feature flags: FEATURE_<NAME>_ENABLED=true|false (default: false — features are opt-in)
# Add one entry per feature. Must match the featureId declared on the RouteModule.
# FEATURE_SEARCH_V2_ENABLED=false
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_POSTINGS_INDEX=postings
LOG_LEVEL=debug
LOG_SERVICE_NAME=backend
LOG_FALLBACK_DIRECTORY=/app/logs/fallback
POSTINGS_THUMBNAIL_PREFETCH=10
POSTINGS_THUMBNAIL_MAX_ATTEMPTS=5
POSTINGS_PUBLIC_CACHE_TTL_JITTER_RATIO=0.1
RECOMMENDATIONS_PRECOMPUTE_POLL_INTERVAL_MS=5000
RECOMMENDATIONS_PRECOMPUTE_BATCH_SIZE=25
RABBITMQ_URL=amqp://rabbitmq:5672
FRONTEND_URL=http://localhost:3040
APP_BASE_URL=http://localhost:3040
MFA_BYPASS_EMAILS=owner1@rentify.local,owner2@rentify.local,owner3@rentify.local,owner4@rentify.local,user1@rentify.local,user2@rentify.local,user3@rentify.local,user4@rentify.local,viewer1@rentify.local,admin1@rentify.local,moderator1@rentify.local,user5@rentify.local,user6@rentify.local,user7@rentify.local,user8@rentify.local
MFA_TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GMAIL_USER=change-me@example.com
GMAIL_APP_PASSWORD=change-me
SMS_PROVIDER=noop
SMS_FROM_NUMBER=
SMS_WEBHOOK_PUBLIC_URL=http://localhost:8040/api/v1/sms/webhooks/telnyx
SMS_WORKER_PREFETCH=10
SMS_MAX_ATTEMPTS=8
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
ACCESS_TOKEN_SECRET=change-me-access-token-secret
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
PERSONAL_ACCESS_TOKEN_SECRET=change-me-personal-access-token-secret
SQUARE_ACCESS_TOKEN=change-me-square-access-token
SQUARE_LOCATION_ID=change-me-square-location-id
SQUARE_WEBHOOK_SIGNATURE_KEY=change-me-square-webhook-signature-key
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:8040/api/v1/payments/webhooks/square
NEXT_PUBLIC_API_BASE_URL=http://localhost:8040/api/v1
INTERNAL_API_BASE_URL=http://backend:8040/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_OAUTH_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_OAUTH_TENANT=consumers
